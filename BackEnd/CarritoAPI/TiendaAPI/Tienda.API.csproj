    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiendaNegocio\Tienda.Negocio.csproj" />
  </ItemGroup>

</Project>
